#!/bin/sh
# swarm CLI launcher. The venv lives outside the plugin, so it survives plugin updates; it is
# (re)built only when requirements.txt changes. Then it runs the swarm package from this plugin.
if [ "${OS:-}" = "Windows_NT" ]; then   # Git Bash on Windows: the Python entry does the work
  L="$(cd "$(dirname "$0")/.." && pwd)/lib/swarm/winlaunch.py"
  command -v cygpath >/dev/null 2>&1 && L="$(cygpath -w "$L")"
  if command -v py >/dev/null 2>&1; then exec py -3 "$L" "$@"; fi
  if command -v python >/dev/null 2>&1; then exec python "$L" "$@"; fi
  echo "swarm: Python 3.11 or newer was not found on PATH" >&2; exit 1
fi
D="$(cd "$(dirname "$0")/.." && pwd)"
REQ="$(cat "$D/requirements.txt" "$D/requirements-postgres.txt" | cksum | cut -d' ' -f1)"
# One venv per requirements stamp (venv-<stamp> beside the old one), so two plugin versions with
# different requirements never rebuild one shared venv in turn (each rebuild is minutes of pip, and
# a killed one left its lock behind). $SWARM_VENV names one venv explicitly and is used as is. An old
# install's venv/ whose stamp matches is still used, so the upgrade rebuilds nothing.
if [ -n "${SWARM_VENV:-}" ]; then
  V="$SWARM_VENV"
else
  VB="$HOME/.local/share/swarm/venv"
  V="$VB-$REQ"
  if [ ! -x "$V/bin/python" ] && [ -x "$VB/bin/python" ] && [ "$(cat "$VB/.swarm-requirements" 2>/dev/null)" = "$REQ" ]; then
    V="$VB"
  fi
fi
# What this launcher changes in the environment (below), as it was before: `swarm bg` gives the
# command it wraps exactly the environment it would have had unwrapped (swarm.bg.caller_env).
# _SWARM_PRE_<VAR> is exported only when VAR was set; _SWARM_LAUNCHER says the record is there.
for _v in PYTHONPATH PYTHONPYCACHEPREFIX PYTHONDONTWRITEBYTECODE; do unset "_SWARM_PRE_$_v"; done
[ -n "${PYTHONPATH+x}" ] && export _SWARM_PRE_PYTHONPATH="$PYTHONPATH"
[ -n "${PYTHONPYCACHEPREFIX+x}" ] && export _SWARM_PRE_PYTHONPYCACHEPREFIX="$PYTHONPYCACHEPREFIX"
[ -n "${PYTHONDONTWRITEBYTECODE+x}" ] && export _SWARM_PRE_PYTHONDONTWRITEBYTECODE="$PYTHONDONTWRITEBYTECODE"
export _SWARM_LAUNCHER=1
# Bytecode cache: without one every run recompiles ~1 MB of source (~0.2 s of each command, and of
# each hook that reaches Python). It lives beside the venv, which already holds code this user runs,
# and is used only when it is this user's own, unshared directory (a sandboxed agent can't plant
# bytecode there: no symlink, no group/world access, no ACL entries). Otherwise nothing is cached and
# nothing is written (PYTHONDONTWRITEBYTECODE), so the plugin tree and the venv stay clean.
PYC="${SWARM_PYCACHE:-$HOME/.local/share/swarm/pyc}"
if { [ -d "$PYC" ] || mkdir -p -m 700 "$PYC" 2>/dev/null; } && [ -O "$PYC" ] && [ ! -L "$PYC" ]; then
  case "$(ls -ld "$PYC" 2>/dev/null)" in
    d???------\ *|d???------.\ *) export PYTHONPYCACHEPREFIX="$PYC";;
    *) export PYTHONDONTWRITEBYTECODE=1;;
  esac
else
  export PYTHONDONTWRITEBYTECODE=1
fi
# Dependencies: requirements.txt always; requirements-postgres.txt (psycopg) only for a Postgres
# board: swarm/pgwant.py (run by the system python3, which tomllib needs: 3.11+) reads the config
# the way cli.load_config does (--config PATH, else $SWARM_CONFIG, else the default), or this venv
# already has psycopg (an existing install keeps it). Both files pin exact versions with hashes:
# pip installs them hash-checked, as wheels only.
has_pkg() {
  for init in "$V"/lib/python3*/site-packages/$1/__init__.py; do [ -f "$init" ] && return 0; done
  return 1
}
WANT_PG=""
if has_pkg psycopg; then
  WANT_PG=1
else
  CFGARG=""; _prev=""
  for _a in "$@"; do
    case "$_prev" in --config) CFGARG="$_a";; esac
    case "$_a" in --config=*) CFGARG="${_a#--config=}";; esac
    _prev="$_a"
  done
  if [ -n "$CFGARG" ]; then
    python3 -I "$D/lib/swarm/pgwant.py" --config "$CFGARG" 2>/dev/null && WANT_PG=1
  else
    python3 -I "$D/lib/swarm/pgwant.py" 2>/dev/null && WANT_PG=1
  fi
fi
# Needs (re)install: no interpreter, another requirements stamp, or a required package missing
# from the venv (a glob, no Python start: an unmatched glob leaves the literal path, which fails -f).
stale() {
  [ -x "$V/bin/python" ] || return 0
  [ "$(cat "$V/.swarm-requirements" 2>/dev/null)" = "$REQ" ] || return 0
  has_pkg zstandard || return 0
  [ -z "$WANT_PG" ] || has_pkg psycopg || return 0
  return 1
}
if stale; then
  mkdir -p "$(dirname "$V")"
  # The build lock is the directory $V.building, holding "<pid> <host>" of its owner. A lock whose
  # owner is gone (same host, pid dead) or that is older than SWARM_LOCK_STALE_MINUTES (default 20: a
  # killed build, or one on another host) is removed and the lock taken again: a killed rebuild used
  # to hang every swarm command until the 300 s wait ran out.
  LOCK="$V.building"
  STALE_MIN="${SWARM_LOCK_STALE_MINUTES:-20}"
  HOST="$(hostname 2>/dev/null || uname -n)"
  lock_stale() {
    [ -d "$LOCK" ] || return 1
    read -r _pid _host < "$LOCK/owner" 2>/dev/null || { _pid=""; _host=""; }
    case "$_pid" in
      ""|*[!0-9]*) ;;      # no owner record yet (just created, or killed before writing it): age decides
      *) [ "$_host" = "$HOST" ] && ! kill -0 "$_pid" 2>/dev/null && return 0;;
    esac
    [ -n "$(find "$LOCK" -prune -mmin "+$STALE_MIN" 2>/dev/null)" ]
  }
  lock_release() { [ "$(cat "$LOCK/owner" 2>/dev/null)" = "$$ $HOST" ] && rm -rf "$LOCK"; }
  i=0
  while :; do
    if mkdir "$LOCK" 2>/dev/null; then
      echo "$$ $HOST" > "$LOCK/owner" 2>/dev/null
      break
    fi
    if lock_stale; then
      # rename first: of several waiters seeing the same stale lock only one wins the rename
      GONE="$LOCK.stale.$$"
      if mv "$LOCK" "$GONE" 2>/dev/null; then
        echo "swarm: removed a stale build lock ($LOCK)" >&2
        rm -rf "$GONE"
        continue
      fi
    fi
    i=$((i + 1)); [ "$i" -gt 300 ] && { echo "swarm: $LOCK is held (not stale: its owner is running and it is younger than $STALE_MIN minutes); remove it if you are sure no build is running, then retry" >&2; exit 1; }
    sleep 1
  done
  trap lock_release EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  if stale; then
    if [ ! -x "$V/bin/python" ] && ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
      echo "swarm: Python 3.11 or newer is needed to set up $V (python3 on PATH is older or missing)" >&2
      exit 1
    fi
    echo "swarm: setting up $V (first run or new requirements)..." >&2
    pip_install() {
      if [ -n "$WANT_PG" ]; then
        PIP_DISABLE_PIP_VERSION_CHECK=1 "$V/bin/python" -m pip install -q --require-hashes --only-binary=:all: \
          -r "$D/requirements.txt" -r "$D/requirements-postgres.txt" >&2
      else
        PIP_DISABLE_PIP_VERSION_CHECK=1 "$V/bin/python" -m pip install -q --require-hashes --only-binary=:all: \
          -r "$D/requirements.txt" >&2
      fi
    }
    { [ -x "$V/bin/python" ] || python3 -m venv "$V"; } \
      && pip_install \
      && echo "$REQ" > "$V/.swarm-requirements" \
      || { echo "swarm: could not set up $V. Needs python3 >= 3.11 with venv and pip. Packages are installed as" >&2
           echo "swarm: hash-checked wheels only (pip --require-hashes --only-binary=:all:), so a platform or Python" >&2
           echo "swarm: version with no published wheel, or a hash mismatch, fails here: see pip's error above." >&2
           echo "swarm: Use Python 3.11-3.14 on a supported platform, or install the requirements files by hand." >&2
           exit 1; }
  fi
  lock_release; trap - EXIT INT TERM
fi
PYTHONPATH="$D/lib${PYTHONPATH:+:$PYTHONPATH}" exec "$V/bin/python" -m swarm.cli "$@"
