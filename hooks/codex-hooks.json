{
  "hooks": {
    "SessionStart":  [{"hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/bin/swarm-hook\" --host codex session-start", "timeout": 10}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/bin/swarm-hook\" --host codex start", "timeout": 15, "additionalContextLimit": 8000}]}],
    "PreToolUse":    [{"matcher": "*", "hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/bin/swarm-hook\" --host codex turn", "timeout": 10, "additionalContextLimit": 8000}]}],
    "PostToolUse":   [{"matcher": "*", "hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/bin/swarm-hook\" --host codex done", "timeout": 10}]}],
    "Stop":          [{"hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/bin/swarm-hook\" --host codex session-stop", "timeout": 10}]}],
    "SubagentStop":  [{"hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/bin/swarm-hook\" --host codex stop", "timeout": 10}]}]
  }
}
