# Marks paths the plugin doesn't need at runtime (dev/test/CI only) so `git archive` -- used by
# .github/workflows/release.yml to build the release tarball/zip -- leaves them out. Runtime is
# bin/swarm's bootstrap (lib/, requirements.txt, data/ name lists) plus the plugin manifests,
# hooks and skills; install.sh is a one-time installer, not something the plugin imports, and is
# attached to releases separately instead of bundled in the archive.
/.github/            export-ignore
/tests/              export-ignore
/e2e/                export-ignore
/docs/superpowers/   export-ignore
/scripts/            export-ignore
/install.sh          export-ignore
/.gitignore          export-ignore
/.gitattributes      export-ignore

# Text is LF in every checkout, Windows included (core.autocrlf would otherwise turn the sh
# launcher and the test fixtures into CRLF, which sh and the byte-exact tests refuse).
* text=auto eol=lf

# Line endings are part of the executable format: the sh scripts need LF (a CRLF shebang line
# fails on Linux/macOS and under Git Bash), the Windows batch files need CRLF (cmd's goto labels
# misparse bare LF), whatever core.autocrlf says on the checkout machine.
/bin/swarm           text eol=lf
/bin/swarm-hook      text eol=lf
/install.sh          text eol=lf
*.sh                 text eol=lf
*.cmd                text eol=crlf
*.ps1                text eol=crlf
/install.ps1         export-ignore

/skills/complexity-analyzer/tools/ export-ignore
**/node_modules/ export-ignore
